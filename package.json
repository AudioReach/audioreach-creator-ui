{
  "name": "AudioReach™ Creator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AudioReach Creator to create/view use cases and tune audio modules",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run build",
    "build:ci": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run build",
    "dev": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 DEV=true node ./node_modules/turbo/bin/turbo run dev",
    "dev:ui": "pnpm dev --filter='!@audioreach-creator-ui/electron-app'",
    "dev:electron": "pnpm run -C packages/electron-app dev",
    "typecheck": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run typecheck",
    "package": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run package",
    "lint": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run lint",
    "lint:ci": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run lint --continue",
    "lint:cache": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run lint --cache-dir=.eslintcache",
    "lint:fix": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run lint -- --fix",
    "test": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run test --env-mode=loose",
    "coverage:merge": "pnpm -C packages/electron-app exec tsx scripts/merge-coverage.ts",
    "coverage:prepare": "pnpm -C packages/electron-app exec tsx scripts/merge-coverage.ts --prepare",
    "test:ci": "pnpm run coverage:prepare && run-s --continue-on-error test:ci:run coverage:merge",
    "test:ci:run": "node ./node_modules/cross-env/src/bin/cross-env.js COVERAGE=true FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run test:ci --env-mode=loose",
    "release": "node ./node_modules/cross-env/src/bin/cross-env.js FORCE_COLOR=1 node ./node_modules/turbo/bin/turbo run make",
    "bundle": "run-s build package",
    "api-utils": "pnpm -C packages/api-utils",
    "electron-app": "pnpm -C packages/electron-app",
    "react-app": "pnpm -C packages/react-app",
    "clean": "pnpm run -C packages/electron-app clean && pnpm run -C packages/react-app clean && pnpm run -C packages/api-utils clean",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check .",
    "setup-ai-links": "node scripts/setup-ai-links.js"
  },
  "devDependencies": {
    "@qualcomm-ui/eslint-config-fsd": "^3.0.0",
    "@qualcomm-ui/eslint-config-mdx": "^4.0.0",
    "@qualcomm-ui/eslint-config-react": "^2.0.0",
    "@qualcomm-ui/eslint-config-typescript": "^4.0.0",
    "@qualcomm-ui/eslint-plugin-react": "^1.2.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-comment-length": "^2.3.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-junit": "^16.0.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
