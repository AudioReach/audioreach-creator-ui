{
  "name": "@audioreach-creator-ui/react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React FrontEnd for AudioReach Creator",
  "scripts": {
    "dev:site": "vite -c vite.config.ts --host --clearScreen=false",
    "dev:ts": "tsc -b tsconfig.lib.json -w --preserveWatchOutput --force",
    "dev": "run-p dev:site dev:ts",
    "build": "tsc -b tsconfig.lib.json --force && vite build",
    "typecheck": "tsc -b tsconfig.lib.json --force --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{js,mjs,ts}\" --quiet",
    "preview": "vite preview -c vite.config.ts",
    "watch": "tsc -p tsconfig.lib.json -w --preserveWatchOutput --force",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "clean": "shx rm -rf dist",
    "format": "prettier --write \"**/*.{js,ts,json,md,jsx,tsx}\" --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@audioreach-creator-ui/api-utils": "workspace:*",
    "@qualcomm-ui/core": "^1.12.0",
    "@qualcomm-ui/dom": "^1.2.0",
    "@qualcomm-ui/qds-core": "^1.36.0",
    "@qualcomm-ui/react": "^1.28.0",
    "@qualcomm-ui/react-core": "^1.6.0",
    "@qualcomm-ui/utils": "^1.4.0",
    "@xyflow/react": "^12.11.3",
    "elkjs": "^0.12.0",
    "flexlayout-react": "^0.10.5",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@audioreach-creator-ui/tsconfig": "workspace:*",
    "@qualcomm-ui/tailwind-plugin": "1.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-transform-stub": "^2.0.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3",
    "vite": "^8.2.1"
  }
}
