{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "types": ["jest", "@testing-library/jest-dom"]
  },
  "include": [
    "./src/**/*.spec.tsx",
    "./src/**/*.test.tsx",
    "./tests/**/*.ts",
    "./tests/**/*.tsx",
    "./test"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
